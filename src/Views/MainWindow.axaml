<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfBooklet.ViewModels"
        xmlns:controls="using:PdfBooklet.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
        x:Class="PdfBooklet.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="820" Height="680"
        MinWidth="560" MinHeight="480"
        Title="PdfBooklet">

    <DockPanel IsEnabled="{Binding CanInteract}">

        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{Binding StatusMessage}"/>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="12">
                <Button Classes="tool" Command="{Binding OpenPdfCommand}" ToolTip.Tip="Import PDF" AutomationProperties.Name="Import PDF">
                    <Viewbox Width="32" Height="32">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource ImportIconTray}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                            <Path Data="{StaticResource ImportIconArrow}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Classes="tool" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                    <Viewbox Width="32" Height="32">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource SettingsIcon}" Fill="{Binding $parent[Button].Foreground}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Classes="tool accent" Command="{Binding ExportCommand}" ToolTip.Tip="Export booklet" AutomationProperties.Name="Export booklet">
                    <Viewbox Width="32" Height="32">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource ImportIconTray}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                            <Path Data="{StaticResource ExportIconArrow}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>

            <StackPanel VerticalAlignment="Center" Margin="8,0,0,0" Spacing="2">
                <TextBlock Text="{Binding SourceSummary}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LayoutSummary}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" Foreground="#E5484D" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8">
            <Button Content="◀" Command="{Binding PreviousSheetCommand}" MinWidth="40" HorizontalContentAlignment="Center"/>
            <TextBlock Text="{Binding SheetLabel}" VerticalAlignment="Center" MinWidth="110" TextAlignment="Center"/>
            <Button Content="▶" Command="{Binding NextSheetCommand}" MinWidth="40" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <Border Margin="12,0,12,0" Background="#6B6F76" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <controls:BookletPreview Plan="{Binding Plan}" SheetIndex="{Binding SheetIndex}"/>
        </Border>
    </DockPanel>
</Window>
