<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfBooklet.ViewModels"
        x:Class="PdfBooklet.Views.InfoDialog"
        x:DataType="vm:InfoDialogViewModel"
        Title="{Binding Title}"
        Width="560" Height="240"
        MinWidth="420" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="{Binding PrimaryMessage}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="12,12,12,8"/>

        <Border Grid.Row="1"
                IsVisible="{Binding HasDetail}"
                Padding="12">
            <ScrollViewer>
                <SelectableTextBlock Text="{Binding DetailMessage}"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonospaceFont}"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="OK"
                Command="{Binding OkCommand}"
                MinWidth="90"
                Margin="12"
                IsDefault="True"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center"/>
    </Grid>
</Window>
